[Unit]
Description=RK-XCZU15EG-F first-boot setup (grow rootfs)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target
ConditionPathExists=/usr/local/sbin/rk-firstboot.sh

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rk-firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
